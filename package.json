{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "description": "Personal archive and portfolio website",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api run dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "lint": "pnpm --filter web lint && pnpm --filter api lint",
    "test": "pnpm --filter api test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1"
}